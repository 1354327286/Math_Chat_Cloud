.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
tmp/
/work/
/*/work/

# Generated Lean/Lake state. Keep lean-toolchain and lake-manifest.json tracked.
/lean/.lake/
/lean/.cache/
/lean/.elan/
/lean/lake-packages/

.agents/
.codex/

# Private project registry overlay. The tracked projects.json is examples only.
/projects.local.json
/private_terms.local.txt

.lancedb/
*.lancedb/
*.extracted/

notes_rewritten.md

# Private research data in any top-level problem directory.
/*/research_state.md
/*/goal.md
/*/progress.md
/*/subgoal.md
/*/20??-??-??.md

/*/notes/**
!/*/notes/
!/*/notes/.gitkeep

/*/memory/**
!/*/memory/
!/*/memory/.gitkeep

/*/refs/**
!/*/refs/
!/*/refs/.gitkeep

/*/downloads/**
!/*/downloads/
!/*/downloads/.gitkeep

# Drop unprocessed research reports here instead of the repository root.
inbox/**
!inbox/
!inbox/README.md

# Local relay files for web-only Pro research runs in each problem.
/*/handoff/**
!/*/handoff/
!/*/handoff/.gitkeep

.DS_Store
Thumbs.db

# Everything at the repository root is private unless explicitly allowlisted.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/projects.json
!/pyproject.toml
!/reference_index.py
!/search_arxiv_theorems.py
!/search_references.py
!/.github/
!/.githooks/
!/dashboard/
!/docs/
!/example_math_problem/
!/inbox/
!/lean/
!/scripts/
!/skills/
!/templates/
!/tests/

# Private problem-specific Lean sources travel in problem bundles, not Git.
/lean/MathDailyLean/Projects/**
!/lean/MathDailyLean/Projects/README.md
